{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@constants": ["app/commons/constants/index.ts"],
      "@interfaces": ["app/commons/interface/index.ts"],
      "@types": ["app/commons/types/index.ts"],
      "@ui-views": ["app/ui/views/index.ts"],
      "@signals-services": ["app/core/signals/index.ts"],
      "@enums": ["app/commons/enums/index.ts"],
      "@utils" : ["app/commons/utils/index.ts"]
    },
    "moduleResolution": "bundler",
    "strict": true,
    "target": "ES2022",
    "module": "es2022",
    "experimentalDecorators": true,
    "importHelpers": true
  }
}
